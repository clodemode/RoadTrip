# RoadTrip local settings. Copy this file to .env and fill in the blanks:
#
#   cp -n .env.example .env
#
# .env is gitignored and stays out of the image build; this example is tracked
# and holds no secret. A blank value means "unset". On Fly the secrets below
# are Fly secrets and the rest is fly.toml [env]; nothing here is read there.

# --- secrets: blank here, real values only in .env -------------------------
# bcrypt hash from `docker run --rm roadtrip -hash '<password>'`; blank = read-only site
ADMIN_PASSWORD_HASH=
# bearer token for pushes by machine; blank = the header path does not exist
PUSH_TOKEN=
# HMAC key for session cookies; blank = random per boot (sign in again after a restart)
SESSION_KEY=
# Claude API key for Chester; blank = Chester is off
ANTHROPIC_API_KEY=

# --- local settings ---------------------------------------------------------
# plain-HTTP local run; leave at 1 (the default) anywhere that serves HTTPS
COOKIE_SECURE=0
SITE_VISIBILITY=public
PIN_PRECISION=snap

# --- Chester (defaults shown) ----------------------------------------------
CHESTER_MODEL_QUICK=claude-opus-5-5
CHESTER_MODEL_PLAN=claude-opus-5-5
CHESTER_EFFORT_QUICK=low
CHESTER_EFFORT_PLAN=medium
CHESTER_DAILY_USD=5
CHESTER_FALLBACK=default

# TomTom search, routing and traffic for the driver screen (leave empty to switch them off)
TOMTOM_API_KEY=

# RoadTracks: album search on the driver screen, read from MusicOrgan (leave the token empty to switch it off)
ROADTRACKS_TOKEN=
ROADTRACKS_BASE=https://music.opeongo.net

# Simulated drives on /driver (set to 1 on a KATE, never on Fly)
SIM_ALLOWED=

# MELT: publish observability records to the fleet Redis, host:port (leave empty to switch it off; always off on Fly)
MELT_REDIS_ADDR=
MELT_VENUE=
# PLAYER_SHELL=0 serves the plain pages with no player frame: the road fall-back
# if the frame misbehaves on a phone. Unset is the normal player. A Fly secret.
PLAYER_SHELL=
